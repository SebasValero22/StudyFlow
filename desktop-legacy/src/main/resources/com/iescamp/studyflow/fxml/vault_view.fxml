<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" style="-fx-background-color: #F4F7FA; -fx-padding: 30;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iescamp.studyflow.controller.VaultController">
    <children>
        <Label text="🔒  \"Say No\" Anti-FOMO Vault" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <Label text="Quarantined ideas to protect Main Quest focus for 84 days." style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;" wrapText="true"/>

        <HBox spacing="10.0">
            <children>
                <TextField fx:id="quickVaultInput" promptText="Trap a shiny object idea here..." HBox.hgrow="ALWAYS">
                    <font>
                        <Font size="13.0" />
                    </font>
                </TextField>
                <Button text="Lock in Vault" onAction="#addQuickVaultItem" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 8 15;" />
            </children>
        </HBox>

        <ListView fx:id="vaultListView" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <cellFactory>
                <Button fx:constant="DEFAULT" />
            </cellFactory>
        </ListView>

        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <children>
                <Label fx:id="vaultStatusLabel" text="0 items in Vault" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" />
                <Button text="Delete Selected" onAction="#deleteSelectedVaultItem" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 5 15;" />
            </children>
        </HBox>
    </children>
</VBox>