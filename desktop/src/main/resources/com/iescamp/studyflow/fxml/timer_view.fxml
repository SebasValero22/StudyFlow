<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" styleClass="sf-timer-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iescamp.studyflow.controller.TimerController">
    <padding>
        <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
    </padding>

    <Label fx:id="modeLabel" styleClass="sf-timer-mode" text="Focus">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <ComboBox fx:id="taskComboBox" prefWidth="300.0" promptText="Select a Task to focus on..." styleClass="sf-input" />

    <Label fx:id="timeLabel" styleClass="sf-timer-clock" text="40:00">
        <font>
            <Font name="Monospaced Bold" size="96.0" />
        </font>
    </Label>

    <Label fx:id="cycleLabel" styleClass="sf-cycle-label" text="Session 1 / 4" />

    <HBox alignment="CENTER" spacing="20.0">
        <Button fx:id="startButton" mnemonicParsing="false" onAction="#toggleTimer" prefHeight="50.0" prefWidth="120.0" styleClass="sf-btn-primary" text="Start">
            <font>
                <Font size="18.0" />
            </font>
        </Button>
        <Button fx:id="skipButton" mnemonicParsing="false" onAction="#skipPhase" prefHeight="50.0" prefWidth="120.0" styleClass="sf-btn-neutral" text="Skip">
            <font>
                <Font size="18.0" />
            </font>
        </Button>
        <Button fx:id="resetButton" mnemonicParsing="false" onAction="#resetTimer" prefHeight="50.0" prefWidth="120.0" styleClass="sf-btn-danger" text="Reset">
            <font>
                <Font size="18.0" />
            </font>
        </Button>
    </HBox>
</VBox>
